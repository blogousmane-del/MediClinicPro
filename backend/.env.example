PORT=5000
JWT_SECRET=your-random-jwt-secret-key-here
NODE_ENV=development

# Supabase Configurations
# Replaces SQLite with a Supabase PostgreSQL instance
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_KEY_HERE

# Google Sign-In (Optional, falls back to email/password only if blank)
# Get this from https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=

# Public URL of the frontend app (used in email links)
APP_URL=http://localhost:5173

# Resend (Optional, preferred over SMTP if set) - https://resend.com/api-keys
# RESEND_FROM_EMAIL must use a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MediClinic Pro <no-reply@mediclinicpro.com>

# SMTP Configurations (Optional fallback if RESEND_API_KEY is blank, falls back to console logs if both blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediClinic Pro" <no-reply@mediclinicpro.com>

# Upstash Redis (Optional - powers shared rate limiting across serverless instances)
# Get these from https://console.upstash.com - falls back to in-memory rate limiting if blank
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL of THIS backend (used to build webhook callback URLs for payment
# providers, e.g. PayTech's ipn_url). Must be a public HTTPS URL in production.
API_PUBLIC_URL=http://localhost:5000

# Bictorys — primary Mobile Money/card provider for Côte d'Ivoire (Optional).
# Get these from https://dashboard.bictorys.com — leave blank to disable online
# payments (cash payments keep working; online checkout returns a clear error).
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_BASE_URL=

# PayTech — secondary/failover Mobile Money provider (Optional).
# Get these from https://paytech.sn dashboard.
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
